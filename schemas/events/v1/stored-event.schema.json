{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://icprelay.org/schemas/events/v1/stored-event.schema.json",
  "title": "Stored Event",
  "description": "A stored event with additional persistence metadata",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "timestamp",
    "source",
    "storedAt",
    "status"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "description": "Unique identifier for the event",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "eventType": {
      "type": "string",
      "description": "Type of the event",
      "enum": [
        "canister.created",
        "canister.updated",
        "canister.deleted",
        "transaction.completed",
        "cycle.transfer"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the event occurred"
    },
    "source": {
      "type": "object",
      "description": "Source of the event",
      "required": [
        "canisterId"
      ],
      "properties": {
        "canisterId": {
          "type": "string",
          "description": "Canister ID that generated the event"
        },
        "subnet": {
          "type": "string",
          "description": "Subnet where the canister resides"
        }
      }
    },
    "data": {
      "type": "object",
      "description": "Event-specific data payload",
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata about the event",
      "properties": {
        "version": {
          "type": "string",
          "description": "Schema version"
        },
        "correlationId": {
          "type": "string",
          "description": "Correlation ID for tracing related events"
        }
      }
    },
    "storedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the event was stored"
    },
    "status": {
      "type": "string",
      "description": "Processing status of the stored event",
      "enum": [
        "pending",
        "processed",
        "failed",
        "archived"
      ]
    },
    "processedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the event was processed"
    },
    "retryCount": {
      "type": "integer",
      "description": "Number of processing retry attempts",
      "minimum": 0,
      "default": 0
    },
    "error": {
      "type": "object",
      "description": "Error information if processing failed",
      "properties": {
        "code": {
          "type": "string",
          "description": "Error code"
        },
        "message": {
          "type": "string",
          "description": "Error message"
        }
      }
    }
  },
  "additionalProperties": false
}
