  {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://icp-relay.io/schemas/events/v1/stored-event.schema.json",
    "title": "ICP Relay StoredEvent (Envelope)",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "receivedAtUtc",
      "raw",
      "canonical"
    ],
    "properties": {
      "schemaVersion": {
        "type": "string",
        "description": "Schema version for this stored envelope (e.g., '1.0').",
        "examples": ["1.0"]
      },
      "correlationId": {
        "type": "string",
        "description": "Optional correlation identifier for tracing across systems.",
        "maxLength": 128
      },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system"],
        "properties": {
          "system": {
            "type": "string",
            "description": "Source system identifier (e.g., 'falcony', 'jira').",
            "minLength": 1,
            "maxLength": 64
          },
          "environment": {
            "type": "string",
            "description": "Optional environment name (e.g., 'prod', 'test').",
            "maxLength": 32
          },
          "senderId": {
            "type": "string",
            "description": "Optional identifier of the webhook sender/installation.",
            "maxLength": 128
          }
        }
      },
      "receivedAtUtc": {
        "type": "string",
        "description": "When the webhook was received by ICP Relay (UTC).",
        "format": "date-time"
      },
      "raw": {
        "type": "object",
        "additionalProperties": false,
        "required": ["payloadRef"],
        "properties": {
          "payloadRef": {
            "type": "string",
            "description": "Reference to raw payload stored in blob (e.g., 'blob://...').",
            "maxLength": 2048
          },
          "hashSha256": {
            "type": "string",
            "description": "Optional SHA-256 hash of the raw payload (hex)."
          },
          "contentType": {
            "type": "string",
            "description": "Optional content type of the raw payload (e.g., 'application/json').",
            "maxLength": 128
          },
          "sizeBytes": {
            "type": "integer",
            "description": "Optional payload size in bytes.",
            "minimum": 0
          }
        }
      },
      "canonical": {
        "description": "Canonical event representation conforming to the ICP Relay CanonicalEvent schema.",
        "type": "object",
        "additionalProperties": true
      },
      "normalized": {
        "description": "Normalized event representation used by notifications and routing. Compatible with ICP Lite NotificationEvent fields.",
        "type": "object",
        "additionalProperties": true
      },
      "routing": {
        "type": "object",
        "description": "Optional routing state and delivery attempts.",
        "additionalProperties": false,
        "properties": {
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["targetType", "state"],
              "properties": {
                "targetType": {
                  "type": "string",
                  "description": "Target type (e.g., 'teams', 'sms', 'rest', 'sharepoint').",
                  "maxLength": 32
                },
                "state": {
                  "type": "string",
                  "description": "Delivery state.",
                  "enum": ["pending", "succeeded", "failed", "skipped"]
                },
                "attempts": {
                  "type": "integer",
                  "minimum": 0
                },
                "lastAttemptAtUtc": {
                  "type": "string",
                  "format": "date-time"
                },
                "lastError": {
                  "type": "string",
                  "maxLength": 4000
                }
              }
            },
            "maxItems": 64
          }
        }
      },
      "tags": {
        "type": "array",
        "description": "Optional tags for filtering and grouping.",
        "items": { "type": "string", "minLength": 1, "maxLength": 64 },
        "maxItems": 64,
        "uniqueItems": true
      }
    }
  }
