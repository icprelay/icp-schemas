{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/icprelay/icp-schemas/v1.0.0/schemas/events/v1/stored-event.bundled.schema.json",
  "title": "ICP Relay StoredEvent (Bundled)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receivedAtUtc",
    "raw",
    "canonical"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Schema version for this stored envelope (e.g., '1.0').",
      "examples": [
        "1.0"
      ]
    },
    "idempotencyKey": {
      "type": "string",
      "description": "Idempotency key for preventing duplicate requests.",
      "maxLength": 256
    },
    "correlationId": {
      "type": "string",
      "description": "Optional correlation identifier for tracing across systems.",
      "maxLength": 128
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system"
      ],
      "properties": {
        "system": {
          "type": "string",
          "description": "Source system identifier (e.g., 'shopify', 'jira').",
          "minLength": 1,
          "maxLength": 64
        },
        "environment": {
          "type": "string",
          "description": "Optional environment name (e.g., 'prod', 'test').",
          "maxLength": 32
        },
        "senderId": {
          "type": "string",
          "description": "Optional identifier of the webhook sender/installation.",
          "maxLength": 128
        }
      }
    },
    "receivedAtUtc": {
      "type": "string",
      "description": "When the webhook was received by ICP Relay (UTC).",
      "format": "date-time"
    },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payloadRef"
      ],
      "properties": {
        "payloadRef": {
          "type": "string",
          "description": "Reference to raw payload stored in blob (e.g., 'blob://...').",
          "maxLength": 2048
        },
        "hashMd5": {
          "type": "string",
          "description": "Optional MD5 hash of the raw payload (hex)."
        },
        "contentType": {
          "type": "string",
          "description": "Optional content type of the raw payload (e.g., 'application/json').",
          "maxLength": 128
        },
        "sizeBytes": {
          "type": "integer",
          "description": "Optional payload size in bytes.",
          "minimum": 0
        }
      }
    },
    "canonical": {
      "description": "Canonical event representation conforming to the ICP Relay CanonicalEvent schema.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "correlationId",
        "source",
        "eventType",
        "occurredAtUtc",
        "data"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "description": "Schema version for this canonical event (e.g., \"1.0\")",
          "examples": [
            "1.0"
          ]
        },
        "eventId": {
          "type": "string",
          "description": "ICP event id",
          "format": "uuid"
        },
        "sourceEventId": {
          "type": "string",
          "description": "Optional upstream id",
          "format": "string",
          "maxLength": 128
        },
        "correlationId": {
          "type": "string",
          "maxLength": 128
        },
        "source": {
          "type": "string",
          "description": "Source system",
          "maxLength": 64
        },
        "eventType": {
          "type": "string",
          "description": "Source system event type (e.g. core.smoke, jira.issue.updated)",
          "maxLength": 128
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "description": "Vendor system object type (e.g. ticket, audit)",
              "maxLength": 64
            },
            "id": {
              "type": "string",
              "description": "Vendor system object id (e.g. ticket-141, audit #1233)",
              "maxLength": 256
            }
          }
        },
        "occurredAtUtc": {
          "type": "string",
          "description": "Timestamp from the payload, when the event happened.",
          "format": "date-time"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "tags": {
      "type": "array",
      "description": "Optional tags for filtering and grouping.",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "maxItems": 64,
      "uniqueItems": true
    }
  }
}