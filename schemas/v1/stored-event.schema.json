{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/icprelay/icp-schemas/v1.0.1/schemas/events/v1/stored-event.schema.json",
  "title": "ICP Relay StoredEvent (Envelope)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "correlationId",
    "source",
    "receivedAtUtc",
    "storage",
    "routing",
    "idempotency",
    "raw",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Schema version for this stored envelope (e.g., '1.0')."
    },
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "EventId generated by Ingest function"
    },
    "correlationId": {
      "type": "string",
      "description": "Identifier for tracing across systems.",
      "maxLength": 128
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system"
      ],
      "properties": {
        "system": {
          "type": "string",
          "description": "Source system identifier (e.g., 'falcony', 'jira').",
          "minLength": 1,
          "maxLength": 64
        },
        "environment": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional environment identifier (e.g., 'prod', 'test').",
          "maxLength": 32
        },
        "senderId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional sender identifier if source system has multiple senders.",
          "maxLength": 128
        }
      }
    },
    "receivedAtUtc": {
      "type": "string",
      "description": "When the webhook was received by ICP Relay (UTC).",
      "format": "date-time"
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefix",
        "rawContainer",
        "storedContainer"
      ],
      "description": "Storage layout info (blob prefix etc.). Not used for routing.",
      "properties": {
        "prefix": {
          "type": "string",
          "description": "Blob prefix used to group blobs (often time-based).",
          "maxLength": 256
        },
        "rawContainer": {
          "type": "string",
          "description": "Container for raw payloads.",
          "maxLength": 128
        },
        "storedContainer": {
          "type": "string",
          "description": "Container for StoredEvent envelopes.",
          "maxLength": 128
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantKey",
        "eventType"
      ],
      "description": "Routing/business partition used by mapper.",
      "properties": {
        "tenantKey": {
          "type": "string",
          "description": "Business routing key, typically 'source:tenant' (e.g., 'falcony:company-0'). Used for Service Bus properties and idempotency PK scope.",
          "maxLength": 128
        },
        "eventType": {
          "type": "string",
          "description": "Raw source event type (e.g., 'observation', 'smoke').",
          "maxLength": 128
        },
        "subject": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "description": "Optional subject of the event if easily available at ingest time.",
          "properties": {
            "type": {
              "type": "string",
              "maxLength": 64
            },
            "id": {
              "type": "string",
              "maxLength": 256
            }
          }
        }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "algorithm",
        "scopeKey"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "Idempotency key (e.g., sha256 of payload, or source entity+revision).",
          "maxLength": 256,
          "minLength": 16
        },
        "algorithm": {
          "type": "string",
          "description": "How the idempotency key was derived.",
          "enum": [
            "sha256",
            "source-id",
            "source-id-revision",
            "custom"
          ]
        },
        "scopeKey": {
          "type": "string",
          "description": "Scope for idempotency, typically equals routing.tenantKey.",
          "maxLength": 128
        }
      }
    },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payloadRef"
      ],
      "properties": {
        "payloadRef": {
          "type": "string",
          "description": "Reference to raw payload stored in blob (e.g., 'blob://...').",
          "maxLength": 2048
        },
        "contentType": {
          "type": "string",
          "description": "Optional content type of the raw payload (e.g., 'application/json').",
          "maxLength": 128
        },
        "sizeBytes": {
          "type": "integer",
          "description": "Optional payload size in bytes.",
          "minimum": 0
        }
      }
    },
    "canonical": {
      "description": "Canonical event representation conforming to the ICP Relay CanonicalEvent schema.",
      "$ref": "./canonical-event.schema.json"
    },
    "status": {
      "type": "string",
      "enum": ["received", "canonicalized", "failed", "unknown", "ignored"],
      "description": "Processing status of the payload"
    },
    "errors": {
      "type": "array",
      "description": "Optional list of errors (for failed/unknown cases).",
      "default":[],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message",
          "atUtc"
        ],
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 2048
          },
          "code": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "atUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "links": {
      "type": "array",
      "description": "Optional URLs to open the original entity in the source system.",
      "default":[],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rel",
          "url"
        ],
        "properties": {
          "rel": {
            "type": "string",
            "maxLength": 32
          },
          "url": {
            "type": "string",
            "maxLength": 2048
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "description": "Optional tags for filtering and grouping.",
      "default":[],
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "maxItems": 64,
      "uniqueItems": true
    }
  }
}